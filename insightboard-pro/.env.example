# ─── Application ───────────────────────────────────────────────
APP_NAME=InsightBoard
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ─── Frontend (Next.js) ────────────────────────────────────────
# Required for auth middleware — copy from Supabase → Settings → API
# (frontend/next.config.mjs loads monorepo root .env; you can also use frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend (FastAPI) ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=insightboard
POSTGRES_PASSWORD=insightboard_secret
POSTGRES_DB=insightboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local Docker:
DATABASE_URL=postgresql+asyncpg://insightboard:insightboard_secret@postgres:5432/insightboard

# Supabase (copy from Dashboard → ORM → Prisma; same vars work for FastAPI/Alembic):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ─── Redis ─────────────────────────────────────────────────────
# Use localhost when running API/Celery outside Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → JWT Keys → Legacy JWT Secret → Reveal (HS256 verification)
# Backend also accepts new signing keys via JWKS automatically.
SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# ─── Dataset uploads (ETL) ─────────────────────────────────────
# Windows example: UPLOAD_TEMP_DIR=C:\\Temp\\insightboard_uploads
UPLOAD_TEMP_DIR=
SUPABASE_DATASETS_BUCKET=datasets

# ─── Groq (primary LLM — OpenAI-compatible API) ───────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── OpenAI (optional fallback if GROQ_API_KEY is unset) ─────
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# ─── Supabase (hosted Postgres) ────────────────────────────────
# Dashboard → Project Settings → Database → Connection string → URI (Session pooler).
# Prefer the pooler host (aws-0-*.pooler.supabase.com) on Windows; direct db.*.supabase.co
# is often IPv6-only. Use the database password as plain text in .env (quoted if needed),
# not double URL-encoded % sequences unless you paste Supabase's full URI unchanged.
# Example (replace region, ref, password):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Or keep direct db.* URL and set pooler host (region from Supabase dashboard):
# DATABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com

# ─── Docker Compose overrides (local host) ─────────────────────
# Use these when running services outside Docker:
# DATABASE_URL=postgresql+asyncpg://insightboard:insightboard_secret@localhost:5432/insightboard
# REDIS_URL=redis://localhost:6379/0
