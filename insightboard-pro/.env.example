# ─── Application ───────────────────────────────────────────────
APP_NAME=InsightBoard
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ─── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend (FastAPI) ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=insightboard
POSTGRES_PASSWORD=insightboard_secret
POSTGRES_DB=insightboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://insightboard:insightboard_secret@postgres:5432/insightboard

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ─── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ─── Docker Compose overrides (local host) ─────────────────────
# Use these when running services outside Docker:
# DATABASE_URL=postgresql+asyncpg://insightboard:insightboard_secret@localhost:5432/insightboard
# REDIS_URL=redis://localhost:6379/0
